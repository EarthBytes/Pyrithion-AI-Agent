# Copy to .env and fill in values before running locally or via docker compose:
#   cp .env.example .env
# Or run the guided setup:
#   bash scripts/setup.sh

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=analytics
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/analytics

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=google/gemini-flash-1.5
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_PROVIDER=local

# --- Outbound email (separate from Google Drive) ---
# Personal @outlook.com CANNOT use SMTP — use Gmail or Resend instead.

# Option A — Gmail SMTP (recommended if you have a Gmail app password)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Pyrithion AI
SMTP_FROM_EMAIL=

# Option B — Resend API (free at resend.com, no SMTP needed)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxx
# SMTP_FROM_NAME=Pyrithion AI
# SMTP_FROM_EMAIL=onboarding@resend.dev

# --- Inbound email (disabled for initial testing) ---
IMAP_ENABLED=false
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=60
IMAP_ALLOWED_SENDERS=

# --- Google Drive (service account — not SMTP) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
DRIVE_SYNC_ON_STARTUP=true

API_KEY=

SQL_ALLOWED_TABLES=energy_usage,revenue,users
SQL_ROW_LIMIT=500
