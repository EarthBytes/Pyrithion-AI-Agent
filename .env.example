# Copy to .env and fill in values before running locally or via docker compose:
#   cp .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=analytics
# Local dev only — set user/password to match Postgres:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/analytics

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=google/gemini-flash-1.5
EMBEDDING_MODEL=openai/text-embedding-3-small
# local (default) | api | sentence-transformers
EMBEDDING_PROVIDER=local

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Leave empty for open local API; set in any shared/deployed environment
API_KEY=

SQL_ALLOWED_TABLES=energy_usage,revenue,users
SQL_ROW_LIMIT=500
